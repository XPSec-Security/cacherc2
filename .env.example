# Microsoft Forms C2 - Environment Configuration
# Copy this file to .env and fill in with your actual values

# OIDC Authentication cookie value
# Extract from your browser's DevTools Network tab when logged into Microsoft Forms
# Look for the "OIDCAuth.forms" cookie value
OIDC_AUTH=your_oidc_token_here

# AAD Authentication JWT token
# Extract from your browser's DevTools Network tab when logged into Microsoft Forms
# Look for the "AADAuth.forms" cookie value - it should start with "eyJ"
AAD_AUTH=your_aad_jwt_token_here

# Optional: Form ID (can also be passed as command-line argument)
FORM_ID=your_form_id_here
